[Unit]
Description=Neko Desktop 聊天输入窗 (可打字)
After=neko-overlay.service

[Service]
Type=simple
Environment=QT_QPA_PLATFORM=xcb
Environment=DISPLAY=__DISPLAY__
Environment=QML_XHR_ALLOW_FILE_READ=1
Environment=QT_IM_MODULE=fcitx
Environment=XMODIFIERS=@im=fcitx
Environment=GTK_IM_MODULE=fcitx
Environment=DBUS_SESSION_BUS_ADDRESS=__DBUS__
Environment=XDG_RUNTIME_DIR=__RUNTIME__
ExecStart=/usr/bin/qml6 %h/.config/neko-desktop/overlay/input.qml
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
